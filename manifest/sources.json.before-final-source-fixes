{
  "schema": 1,
  "architecture": "arm64",
  "policy": {
    "prebuilt_only": true,
    "build_from_source": false,
    "allow_rclone": false,
    "require_aarch64_elf": true,
    "static_preferred": true,
    "android_system_libs_exception_requires_explicit_allow": true
  },
  "tools": [
    {
      "name": "busybox",
      "provider": "Magisk-Modules-Repo/busybox-ndk",
      "kind": "github_repo_file",
      "path_candidates": [
        "busybox-arm64"
      ],
      "static": "required"
    },
    {
      "name": "toybox",
      "provider": "landley/toybox",
      "kind": "direct",
      "url": "https://landley.net/toybox/downloads/binaries/latest/toybox-aarch64",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "bash",
      "provider": "bnsmb/binaries-for-Android",
      "kind": "github_repo_file",
      "glob_candidates": [
        "binaries/**/bash-static-stripped",
        "binaries/**/bash-static",
        "binaries/**/bash*static*"
      ],
      "static": "required",
      "path_candidates": [
        "binaries/bash-static-stripped",
        "binaries/bash-static"
      ]
    },
    {
      "name": "sqlite3",
      "provider": "bnsmb/binaries-for-Android",
      "kind": "github_repo_file",
      "path_candidates": [
        "binaries/sqlite3-3.51.3.static"
      ],
      "static": "required"
    },
    {
      "name": "jq",
      "provider": "jqlang/jq",
      "kind": "github_release_asset",
      "asset_regex": "^jq-linux-arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "yq",
      "provider": "mikefarah/yq",
      "kind": "github_release_asset",
      "asset_regex": "^yq_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "coreutils",
      "provider": "uutils/coreutils",
      "kind": "github_release_asset",
      "asset_regex": "(?i)aarch64-unknown-linux-musl.*\\.(tar\\.gz|tgz)$",
      "archive": "tar",
      "pick_regex": "(^|/)coreutils$",
      "static": "required"
    },
    {
      "name": "rg",
      "provider": "BurntSushi/ripgrep",
      "kind": "github_release_asset",
      "asset_regex": "(?i)aarch64-unknown-linux-musl.*\\.tar\\.gz$",
      "archive": "tar",
      "pick_regex": "(^|/)rg$",
      "static": "required"
    },
    {
      "name": "fd",
      "provider": "sharkdp/fd",
      "kind": "github_release_asset",
      "asset_regex": "(?i)aarch64-unknown-linux-musl.*\\.tar\\.gz$",
      "archive": "tar",
      "pick_regex": "(^|/)fd$",
      "static": "required"
    },
    {
      "name": "fzf",
      "provider": "junegunn/fzf",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^fzf-.*-linux_arm64\\.tar\\.gz$",
      "archive": "tar",
      "pick_regex": "(^|/)fzf$",
      "static": "required"
    },
    {
      "name": "zoxide",
      "provider": "ajeetdsouza/zoxide",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^zoxide-.*-aarch64-unknown-linux-musl\\.tar\\.gz$",
      "archive": "tar",
      "pick_regex": "(^|/)zoxide$",
      "static": "required"
    },
    {
      "name": "xxd",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^xxd_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "strings",
      "provider": "tiiuae/aarch64_bin_builder",
      "kind": "github_release_asset",
      "asset_regex": "^strings$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "readelf",
      "provider": "tiiuae/aarch64_bin_builder",
      "kind": "github_release_asset",
      "asset_regex": "^readelf$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "objdump",
      "provider": "tiiuae/aarch64_bin_builder",
      "kind": "github_release_asset",
      "asset_regex": "^objdump$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "nm",
      "provider": "tiiuae/aarch64_bin_builder",
      "kind": "github_release_asset",
      "asset_regex": "^nm$",
      "static": "required",
      "optional": true
    },
    {
      "name": "7zz",
      "provider": "bnsmb/binaries-for-Android",
      "kind": "direct",
      "url": "https://raw.githubusercontent.com/bnsmb/binaries-for-Android/main/binaries/7zz_26.03_static",
      "static": "required"
    },
    {
      "name": "zstd",
      "provider": "ramabondanp/android_tools",
      "kind": "direct",
      "url": "https://raw.githubusercontent.com/ramabondanp/android_tools/master/bin/zstd-arm64",
      "static": "required"
    },
    {
      "name": "lz4",
      "provider": "dawnxoxo/android-static-binaries",
      "kind": "github_repo_file_glob",
      "glob_candidates": [
        "lz4/**"
      ],
      "static": "required",
      "optional": true
    },
    {
      "name": "xz",
      "kind": "alias",
      "target": "busybox",
      "static": "required"
    },
    {
      "name": "brotli",
      "provider": "dawnxoxo/android-static-binaries",
      "kind": "github_repo_file_glob",
      "glob_candidates": [
        "brotli/**"
      ],
      "static": "required"
    },
    {
      "name": "pigz",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^pigz_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "cpio",
      "provider": "dawnxoxo/android-static-binaries",
      "kind": "github_repo_file_glob",
      "glob_candidates": [
        "cpio/**"
      ],
      "static": "required"
    },
    {
      "name": "curl",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^curl_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "aria2c",
      "provider": "abcfy2/aria2-static-build",
      "kind": "github_release_asset",
      "asset_regex": "(?i).*aarch64-unknown-linux-musl.*",
      "pick_regex": "(^|/)aria2c$",
      "static": "required"
    },
    {
      "name": "rsync",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^rsync_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "socat",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^socat_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "strace",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^strace_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "ltrace",
      "provider": "bnsmb/binaries-for-Android",
      "kind": "github_repo_file",
      "path_candidates": [
        "binaries/ltrace_static"
      ],
      "static": "required"
    },
    {
      "name": "lsof",
      "provider": "whoisnian/static-binaries",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^lsof_.*_linux_arm64$",
      "archive": "none",
      "static": "required"
    },
    {
      "name": "zsh",
      "provider": "dawnxoxo/android-static-binaries",
      "kind": "github_repo_file_glob",
      "glob_candidates": [
        "zsh/**"
      ],
      "static": "required"
    },
    {
      "name": "git",
      "provider": "bnsmb/clang19_toolchain_for_android",
      "kind": "github_repo_file_glob",
      "glob_candidates": [
        "sysroot/**/bin/git"
      ],
      "static": "preferred",
      "allow_android_system_libs": true
    },
    {
      "name": "bat",
      "provider": "sharkdp/bat",
      "kind": "github_release_asset",
      "asset_regex": "(?i)^bat-v.*-aarch64-unknown-linux-musl\\.tar\\.gz$",
      "archive": "tar",
      "pick_regex": "(^|/)bat$",
      "static": "required"
    }
  ]
}
